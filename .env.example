# IMPORTANTE — TELA BRANCA NO PUBLISH:
# O arquivo .env NÃO vai para o git (.gitignore). O deploy compila o projeto
# do zero, então as variáveis VITE_* precisam existir NO AMBIENTE DE BUILD da
# hospedagem (Lovable Cloud / Cloudflare / etc.), senão o app publicado abre
# em branco com "Missing Supabase environment variable(s)".
# - VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY: obrigatórias no BUILD
# - SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY: obrigatórias no RUNTIME (servidor)
SUPABASE_PROJECT_ID="yrkdbrkijpwilhptmqii"
SUPABASE_URL="https://yrkdbrkijpwilhptmqii.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"
SUPABASE_SECRET_KEY="YOUR_SECRET_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SECRET_KEY"
VITE_SUPABASE_PROJECT_ID="yrkdbrkijpwilhptmqii"
VITE_SUPABASE_URL="https://yrkdbrkijpwilhptmqii.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"
